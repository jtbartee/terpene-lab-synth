{
  "name": "terpene-lab-synth",
  "private": true,
  "version": "0.2.0",
  "description": "TERPENE LAB + TERPENE SYNTH: a scientific cannabis-chemistry explorer and a generative electronic music instrument driven by terpene profiles",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/run.mjs",
    "report:diversity": "REPORT=1 vitest run tests/music/report.test.ts",
    "render:demos": "node tests/e2e/render-demos.mjs",
    "data:pubchem": "node scripts/fetch-pubchem.mjs",
    "data:smith": "node scripts/build-smith.mjs",
    "data:ct": "node scripts/build-ct.mjs",
    "data:all": "npm run data:pubchem && npm run data:smith && npm run data:ct",
    "data:validate-similarity": "node scripts/validate-similarity.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@tonejs/midi": "2.0.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tonal": "6.4.3",
    "tone": "15.1.22",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
